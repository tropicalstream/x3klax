<?xml version="1.0" encoding="utf-8"?>
<!--
  X3Klax launcher mark.

  Colored tiles dropping down a chute onto a catch paddle — the game's own
  falling/catching mechanic, not a borrowed shooting-gallery icon. 108dp
  viewport; safe zone is the middle 66dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Chute walls -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#3300F5FF"
        android:strokeWidth="2.5"
        android:pathData="M38,16 L38,64" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#3300F5FF"
        android:strokeWidth="2.5"
        android:pathData="M70,16 L70,64" />

    <!-- Falling tiles, staggered as if mid-drop -->
    <path
        android:strokeColor="#00F5FF"
        android:strokeWidth="3"
        android:fillColor="#9900F5FF"
        android:strokeLineJoin="round"
        android:pathData="M43,22 h10 v10 h-10 z" />
    <path
        android:strokeColor="#FF2DD6"
        android:strokeWidth="3"
        android:fillColor="#99FF2DD6"
        android:strokeLineJoin="round"
        android:pathData="M43,38 h10 v10 h-10 z" />
    <path
        android:strokeColor="#FFE84A"
        android:strokeWidth="3"
        android:fillColor="#99FFE84A"
        android:strokeLineJoin="round"
        android:pathData="M43,54 h10 v10 h-10 z" />

    <!-- Catch paddle -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M24,78 L84,78" />
    <path
        android:strokeColor="#66FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M24,84 L84,84" />

    <!-- A completed row of three, caught -->
    <path
        android:strokeColor="#00F5FF"
        android:strokeWidth="2.5"
        android:fillColor="#8000F5FF"
        android:pathData="M28,66 h9 v9 h-9 z" />
    <path
        android:strokeColor="#FF2DD6"
        android:strokeWidth="2.5"
        android:fillColor="#80FF2DD6"
        android:pathData="M49.5,66 h9 v9 h-9 z" />
    <path
        android:strokeColor="#FFE84A"
        android:strokeWidth="2.5"
        android:fillColor="#80FFE84A"
        android:pathData="M71,66 h9 v9 h-9 z" />
</vector>
